# poc-video manual tests — run from extensions/poc-video/
# (from repo root: just --justfile extensions/poc-video/justfile -d extensions/poc-video <recipe>)
#
# The unit tests (test/validate.test.ts) prove the validator logic; these
# recipes are for eyeballing real validator output against real files —
# the happy path (templates) and the error classes (fixtures).

# list recipes
default:
    @just --list

# one-time setup: npm deps + the Chromium binary (user cache, never committed)
# (uses the extension's own playwright CLI — npx can resolve a different version)
install:
    npm install
    node node_modules/playwright/cli.js install chromium

# happy path: validate the template pair — expect ✔ and no warnings
validate:
    node scripts/validate-storyboard.mjs templates/storyboard.template.yaml templates/vo.template.yaml

# validate any storyboard (+ optional vo.yaml):
#   just check path/to/storyboard.yaml [path/to/vo.yaml]
check *args:
    node scripts/validate-storyboard.mjs {{args}}

# validator + contract unit tests
test:
    node --test test/validate.test.ts

# error-class demos: every fixture in test/fixtures/ must be REJECTED —
# eyeball what the validator actually says for each class, and get a
# non-zero exit if any fixture wrongly passes
demo-errors:
    #!/usr/bin/env bash
    set -uo pipefail
    total=0
    rejected=0
    for f in test/fixtures/invalid-*.storyboard.yaml; do
      total=$((total+1))
      echo; echo "── ${f}"
      if ! node scripts/validate-storyboard.mjs "$f"; then rejected=$((rejected+1)); fi
    done
    total=$((total+1))
    echo; echo "── vo fixture vs valid template storyboard"
    if ! node scripts/validate-storyboard.mjs templates/storyboard.template.yaml test/fixtures/invalid-vo-mismatch.vo.yaml; then rejected=$((rejected+1)); fi
    echo
    if [ "$rejected" -eq "$total" ]; then
      echo "✔ all $total fixtures correctly rejected"
    else
      echo "✖ $((total-rejected)) fixture(s) passed validation — they must not"
      exit 1
    fi

# scaffold a run dir for a target: just init <target> [pocs-root]
init target pocs-root="./pocs" *args:
    node scripts/pass1-init.ts {{target}} --pocs-root {{pocs-root}} {{args}}

# headless smoke test of the browser module (open → navigate → screenshot → close);
# needs the Chromium binary (`just install`) and network — not run by CI
smoke-browser *tmpdir="":
    #!/usr/bin/env bash
    set -euo pipefail
    d="{{tmpdir}}"
    [ -n "$d" ] || d=$(mktemp -d)
    node scripts/pass1-smoke.ts "$d"

# replay a storyboard: just record <run-dir> [watch|step|dry-run]
record run-dir mode="watch" *args:
    node scripts/record.ts {{run-dir}} --mode {{mode}} {{args}}

# headless dry-run smoke of the replay engine against public pages
# (clean pass + broken-selector failure semantics); needs `just install` + network
smoke-record *tmpdir="":
    #!/usr/bin/env bash
    set -euo pipefail
    d="{{tmpdir}}"
    [ -n "$d" ] || d=$(mktemp -d)
    node scripts/record-smoke.ts "$d"

# full gate set: typecheck + lint + tests (what CI enforces on the repo)
gates:
    cd ../.. && npm run typecheck && npx biome check extensions/poc-video && npm test
