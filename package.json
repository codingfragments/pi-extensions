{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo of pi coding agent extensions (codingfragments)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "node --test extensions/**/test/*.test.ts",
    "docs:cli": "node extensions/gdrive-publish/generate-docs.ts",
    "build:gdrive-publish": "tsc -p extensions/gdrive-publish/tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@playwright-labs/ghost-cursor": "^1.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.0",
    "typebox": "^1.3.34",
    "typescript": "^5.9.3",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
