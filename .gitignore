node_modules/
dist/
*.log
.DS_Store

# pi runtime state that shouldn't be committed
.pi/git/
.pi/npm/
.pi/sessions/
.pi/teams
.pi/flow.json

# gdrive-publish: never commit credentials or cached tokens
client_secret*.json
token-*.json

# the sandbox manifest is machine-specific (pins one person's Drive folder)
sandbox/**/.gdrive-manifest.json
