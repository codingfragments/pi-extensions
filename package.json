{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo of pi coding agent extensions (codingfragments)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
