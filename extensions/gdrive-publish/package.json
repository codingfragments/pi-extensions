{
  "name": "gdrive-publish",
  "version": "0.2.0",
  "description": "Publish markdown, CSV and Excel files to Google Drive as native Google Docs and Sheets, rewriting relative links to real Doc URLs with stable sharing links",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gdrive-publish": "bin/gdrive-publish.js"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "files": ["bin/", "core/", "cli.ts", "commands.ts", "generate-docs.ts", "README.md", "MANUAL.md"],
  "keywords": [
    "google-drive",
    "google-docs",
    "google-sheets",
    "markdown",
    "publish",
    "cli",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codingfragments/pi-extensions.git",
    "directory": "extensions/gdrive-publish"
  },
  "homepage": "https://github.com/codingfragments/pi-extensions/tree/main/extensions/gdrive-publish",
  "bugs": "https://github.com/codingfragments/pi-extensions/issues",
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
