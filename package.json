    "test:e2e": "node --test extensions/gdrive-publish/test/e2e/*.e2e.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.0.0",
    "typebox": "*",
    "typescript": "^5.6.0"
  }
}
